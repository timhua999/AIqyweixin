# 复制为 .env 后填写真实值；不要将 .env 提交到 Git。
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env   (Windows CMD)

# --- 应用 ---
APP_ENV=development
LOG_LEVEL=INFO

# Register /debug/* when true, or when APP_ENV=development (still requires DATABASE_URL).
ENABLE_DEBUG_ROUTES=false

# --- PostgreSQL（推荐 asyncpg；也可写 postgresql:// 会自动转为 postgresql+asyncpg://）---
# 示例：postgresql://user:pass@127.0.0.1:5432/aiqyweixin
DATABASE_URL=

# --- 企业微信（智能机器人 JSON 回调，对应 weworkapi_python callback_json_python3 / Sample.py）---
#
# 官方 Sample.py 变量              本项目的 .env
# ------------------------------   ---------------------------
# sToken                           WECOM_TOKEN
# sEncodingAESKey                  WECOM_ENCODING_AES_KEY   （43 位）
# sCorpID（构造 WXBizJsonMsgCrypt） 见下方说明
#
# WECOM_CORP_ID = 我的企业 → 企业信息 → 企业ID（ww 开头）
# WECOM_TOKEN / WECOM_ENCODING_AES_KEY = 智能机器人 API 配置页里的 Token、EncodingAESKey
#
# WECOM_RECEIVE_ID（对应 Sample 第三参数 sReceiveId / receiveid）：
#   - 智能机器人收消息：官方要求传 **空字符串** → 留空即可（不要填企业ID）
#   - 若 GET 保存 URL 只有填企业ID 才能过，可显式写 WECOM_RECEIVE_ID=你的企业ID
#   - 留空时：GET 先企业ID再空串；POST 先空串再企业ID
#
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_RECEIVE_ID=

# 主动回复（POST 回调里的 response_url，见文档 path/101138）
# {content} 会替换为用户消息摘要；留空则默认「已收到您的消息：{content}」
WECOM_REPLY_TEXT=

# 接收消息回调 URL：https://你的域名/wecom/callback

# --- 云端 LLM（OpenAI 兼容：base_url + api_key）---
# 配置后企微消息走大模型 markdown 回复；LLM_ENABLED=false 则用 WECOM_REPLY_TEXT 模板
#
# 【阿里云通义千问 / 百炼 DashScope】
# 控制台：https://bailian.console.aliyun.com/ → API-KEY（北京地域）
# 文档：https://help.aliyun.com/zh/model-studio/compatibility-of-openai-with-dashscope
#
LLM_ENABLED=true
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-你的百炼API_KEY
LLM_MODEL=qwen-plus
# 可选模型：qwen-turbo（更快更省）| qwen-max（更强）| qwen-flash
# 新加坡地域 BASE_URL：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# LLM_SYSTEM_PROMPT=   # 留空使用内置国际物流助手提示词
# 企微询价：每条渠道含描述/附加费/风险提示，展示条数不宜过大
WECOM_QUOTE_MAX_OFFERS=3

# --- 百运 by56.com Router API（docs/api/by56-quote-api.md / open.by56.com）---
BY56_ENABLED=false
# 企微询价需同时：LLM_ENABLED=true、BY56_ENABLED=true 且 BYKEY/SECRET 已填
# 测试 https://unsbapi.by56.com/router/api  生产 https://unapi.by56.com/router/api
BY56_BASE_URL=https://unsbapi.by56.com/router/api
# 对应 C# Post(url, appkey, appSecret, ...)：BYKEY 填第 2 个参数，签名密钥填第 3 个参数（勿与「Key/Secret」中文说明写反）
# 文档样例：BY56_BYKEY=FD981D0B-BC8B-4A55-ABD0-C571B51B4990  BY56_APP_SECRET=028D0512-E130-4EB3-8583-BE7F53FF7085
BY56_BYKEY=
BY56_APP_SECRET=
# BY56_APP_ID=          # 可与 BY56_BYKEY 二选一
BY56_CALLS=byapi
# §3.1 快递查价（与 BY56_METHOD_COMMODITY 默认同一个 method）
BY56_METHOD_QUOTE=By56CustomerAPI.byExpOrder.ExpOrder.GetCommodityEXP
BY56_METHOD_COMMODITY=By56CustomerAPI.byExpOrder.ExpOrder.GetCommodityEXP
# §3.6 货物追踪轨迹 QueryBatch（TrackNo，非 §3.7）
BY56_METHOD_TRACK_BATCH=By56CustomerAPI.byPackOrder.PackOrder.QueryBatch
# §3.7 订单号换取百运跟踪号 GetDeliveryNO（不是查轨迹）
BY56_METHOD_DELIVERY_NO=By56CustomerAPI.byPackOrder.PackOrder.GetDeliveryNO
BY56_TIMEOUT_SECONDS=30
