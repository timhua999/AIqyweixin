# 复制为 .env 后填写真实值；不要将 .env 提交到 Git。
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env   (Windows CMD)

# --- 应用 ---
APP_ENV=development
LOG_LEVEL=INFO

# Register /debug/* when true, or when APP_ENV=development (still requires DATABASE_URL).
ENABLE_DEBUG_ROUTES=false

# --- PostgreSQL（推荐 asyncpg；也可写 postgresql:// 会自动转为 postgresql+asyncpg://）---
# 示例：postgresql://user:pass@127.0.0.1:5432/aiqyweixin
DATABASE_URL=

# --- 企业微信（智能机器人 JSON 回调，对应 weworkapi_python callback_json_python3 / Sample.py）---
#
# 官方 Sample.py 变量              本项目的 .env
# ------------------------------   ---------------------------
# sToken                           WECOM_TOKEN
# sEncodingAESKey                  WECOM_ENCODING_AES_KEY   （43 位）
# sCorpID（构造 WXBizJsonMsgCrypt） 见下方说明
#
# WECOM_CORP_ID = 我的企业 → 企业信息 → 企业ID（ww 开头）
# WECOM_TOKEN / WECOM_ENCODING_AES_KEY = 智能机器人 API 配置页里的 Token、EncodingAESKey
#
# WECOM_RECEIVE_ID（对应 Sample 第三参数 sReceiveId / receiveid）：
#   - 智能机器人收消息：官方要求传 **空字符串** → 留空即可（不要填企业ID）
#   - 若 GET 保存 URL 只有填企业ID 才能过，可显式写 WECOM_RECEIVE_ID=你的企业ID
#   - 留空时：GET 先企业ID再空串；POST 先空串再企业ID
#
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_RECEIVE_ID=

# 接收消息回调 URL：https://你的域名/wecom/callback

# --- 云端 LLM（OpenAI 兼容：base_url + api_key）---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
