# 复制为 .env 后填写真实值；不要将 .env 提交到 Git。
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env   (Windows CMD)

# --- 应用 ---
APP_ENV=development
LOG_LEVEL=INFO

# Register /debug/* when true, or when APP_ENV=development (still requires DATABASE_URL).
ENABLE_DEBUG_ROUTES=false

# --- PostgreSQL（推荐 asyncpg；也可写 postgresql:// 会自动转为 postgresql+asyncpg://）---
# 示例：postgresql://user:pass@127.0.0.1:5432/aiqyweixin
DATABASE_URL=

# --- 企业微信（自建应用等；键名以实现为准）---
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# --- 云端 LLM（OpenAI 兼容：base_url + api_key）---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
